# hermes/.env.example
# Copy to .env and adjust. The .env file is gitignored.

# ─── Permissions ─────────────────────────────────────────
# Host user that owns ./data (run `id -u` / `id -g`). Files created inside the
# container are chowned to these so they stay editable on the host.
HERMES_UID=1000
HERMES_GID=1000

# ─── OpenAI-compatible API server (optional) ─────────────
# The gateway's OpenAI-compatible API server is OFF unless both are set.
# Only enable behind authentication — API_SERVER_KEY is mandatory.
# API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY=your-strong-shared-secret
