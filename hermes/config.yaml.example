# hermes/config.yaml.example
# Reference for hermes/data/config.yaml (HERMES_HOME=/opt/data → ./data).
# The live copy lives in ./data/config.yaml (gitignored). Edit that one, then
# restart:  mc hermes r
#
# This wires Hermes to the local OpenAI-compatible model server on 127.0.0.1:11435:
# the `strata` service since 2026-10-05 (llama-cpp before; it is stopped).

# ─── Model: local server (strata) ────────────────────────────────────────────
model:
  # "custom" = any OpenAI-compatible endpoint (aliases: ollama/vllm/llamacpp).
  provider: "custom"
  # The model server on the host loopback (network_mode: host). Must end in /v1.
  base_url: "http://127.0.0.1:11435/v1"
  # The server ignores the key, but the OpenAI SDK requires a non-empty value.
  api_key: "sk-local"
  # Strata ignores the model name (it advertises qwen3.8-flash-next-iq3_s); any value works.
  default: "qwen3.8-27b-ud-q6-xl"
  # Set the context explicitly; the server's window is 262144 (strata/.env CTX_SIZE).
  context_length: 131072

# ─── Terminal backend ────────────────────────────────────────────────────────
# "local" runs tool commands inside this container — the container is the
# security boundary. Switch to "docker" only if the host docker socket is
# mounted in.
terminal:
  backend: "local"
  cwd: "/opt/data/workspace"
  timeout: 180

agent:
  max_turns: 60
