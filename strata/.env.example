# ─── Image ───
STRATA_VERSION=v0.1.39

# ─── Model ───
# Folder name under data/models/ (one folder per quant, each holding its two GGUF shards) and the quant the volume was set up for.
QUANT=IQ3_S
CTX_SIZE=262144

# ─── Networking ───
TAILSCALE_IP=your-tailscale-ip
HOST_PORT=11435

# ─── Access control ───
# Host names the server answers to besides IP addresses (DNS-rebinding protection): the container name and this machine's Tailscale names
ALLOWED_HOSTS=strata,your-host,your-host.your-tailnet.ts.net
