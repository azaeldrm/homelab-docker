# ── Network ────────────────────────────────────────────────────────────────────
# The external Docker network shared with Kokoro and Ollama containers.
DOCKER_NETWORK=ollama-net

# ── Kokoro TTS ─────────────────────────────────────────────────────────────────
# Container name (or hostname) of your Kokoro-FastAPI instance.
KOKORO_URL=http://kokoro-fastapi:8880
KOKORO_VOICE=af_bella
KOKORO_SPEED=1.0
# KOKORO_MAX_CHUNK=3000

# ── Ollama LLM ─────────────────────────────────────────────────────────────────
# Container name (or hostname) of your Ollama instance.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:27b
# OLLAMA_TEMPERATURE=0.1
# OLLAMA_CONTEXT_LENGTH=32768

# ── Display defaults ───────────────────────────────────────────────────────────
# PAGE_DENSITY=medium   # low (500 chars) / medium (800) / high (1200)
# FONT_SIZE=medium      # small / medium / large
