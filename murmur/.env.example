# ── Required ─────────────────────────────────────────────────────────────────

# Strong random secret for signing JWT tokens.
# Generate one: openssl rand -hex 32
JWT_SECRET=change-me-please-use-openssl-rand-hex-32

# PostgreSQL password for the murmur database user.
POSTGRES_PASSWORD=change-me-strong-db-password

# ── External services (on ollama-net) ────────────────────────────────────────

# TTS — Kokoro-FastAPI
TTS_BASE_URL=http://kokoro-fastapi:8880
TTS_DEFAULT_VOICE=af_bella

# LLM — Ollama (optional — enables enhanced chapter detection + text cleanup)
LLM_BASE_URL=http://ollama:11434

# Embeddings — Ollama (optional — enables semantic search / RAG)
EMBEDDING_BASE_URL=http://ollama:11434

# STT — Whisper (optional — enables voice input)
STT_BASE_URL=http://whisper:9000

# ── Server ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
